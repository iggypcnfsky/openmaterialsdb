# Postgres connection string. Locally: postgres://postgres@localhost:5433/omdb
# Production: Neon *pooled* connection string, e.g. postgres://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Set to false to skip re-seeding from data/ on container start (migrations always run)
SEED_ON_START=true
